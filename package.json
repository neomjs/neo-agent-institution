{
    "name": "neo-agent-institution",
    "version": "0.1.0",
    "type": "module",
    "description": "Agent Institution — mission control for your own standing team of AIs: the Neo.mjs cockpit that shows an agent team's roster, health, work, memories, messages and wake state, and operates its lifecycle over the Brain's Fleet transport — dock layouts, multi-window, Neural Link, native Electron harness.",
    "keywords": [
        "agent-institution",
        "fleet-manager",
        "agent-cockpit",
        "agent-harness",
        "agent-os",
        "ai-agents",
        "ai-native",
        "multi-agent-systems",
        "agent-fleet",
        "fleet-management",
        "mission-control",
        "cockpit",
        "dashboard",
        "dock-layouts",
        "multi-window-applications",
        "neural-link",
        "possession-interface",
        "mcp",
        "electron",
        "web-workers",
        "sharedworker",
        "neo-mjs",
        "javascript"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/neomjs/neo-agent-institution.git"
    },
    "scripts": {
        "postinstall": "neo-agent-skills-materialize",
        "add-config": "node ./node_modules/neo.mjs/buildScripts/create/addConfig.mjs",
        "build-all": "node ./node_modules/neo.mjs/buildScripts/build/all.mjs -n",
        "build-all-questions": "node ./node_modules/neo.mjs/buildScripts/build/all.mjs",
        "build-dist-esm": "node ./node_modules/neo.mjs/buildScripts/build/esmodules.mjs",
        "build-highlightjs": "node ./node_modules/neo.mjs/buildScripts/build/highlightJs.mjs",
        "build-themes": "node ./node_modules/neo.mjs/buildScripts/build/themes.mjs",
        "build-threads": "node ./node_modules/neo.mjs/buildScripts/webpack/buildThreads.mjs",
        "bundle-parse5": "node ./node_modules/neo.mjs/buildScripts/build/parse5.mjs",
        "check-app-file-sizes": "node ./buildScripts/checkAppFileSizes.mjs",
        "check-data-tracking": "node ./buildScripts/checkDataTracking.mjs",
        "check-visual-baselines": "node ./buildScripts/checkVisualBaselines.mjs",
        "stamp-visual-baselines": "node ./buildScripts/checkVisualBaselines.mjs --stamp",
        "check-reactive-tags": "node ./node_modules/neo.mjs/buildScripts/helpers/checkReactiveTags.mjs",
        "convert-design-tokens": "node ./node_modules/neo.mjs/buildScripts/helpers/convertDesignTokens.mjs",
        "create-app": "node ./node_modules/neo.mjs/buildScripts/create/app.mjs",
        "create-app-minimal": "node ./node_modules/neo.mjs/buildScripts/create/appMinimal.mjs",
        "create-class": "node ./node_modules/neo.mjs/buildScripts/create/class.mjs",
        "create-component": "node ./node_modules/neo.mjs/buildScripts/create/component.mjs",
        "server-start": "webpack serve -c ./buildScripts/webpack/webpack.server.config.mjs --open",
        "server-start-ci": "webpack serve -c ./buildScripts/webpack/webpack.server.config.mjs --no-open",
        "generate-docs-json": "node ./node_modules/neo.mjs/buildScripts/docs/generateDocsJson.mjs",
        "test-e2e": "playwright test -c test/playwright/playwright.config.e2e.mjs",
        "test-e2e:nl": "playwright test -c test/playwright/playwright.config.e2e.nl.mjs",
        "test-components": "playwright test -c test/playwright/playwright.config.component.mjs",
        "test-unit": "playwright test -c test/playwright/playwright.config.unit.mjs",
        "test-visual": "playwright test -c test/playwright/playwright.config.visual.mjs",
        "watch-themes": "node ./node_modules/neo.mjs/buildScripts/helpers/watchThemes.mjs"
    },
    "dependencies": {
        "neo-agent-brain": "github:neomjs/neo-agent-brain#8e092750310723bea0c2e329d7ab9aa6860926fb",
        "neo.mjs": "github:neomjs/neo#87ac80a68edde7597d017436796440821c80cf7b"
    },
    "devDependencies": {
        "@fortawesome/fontawesome-free": "^7.3.0",
        "@playwright/test": "^1.63.0",
        "acorn": "^8.17.0",
        "astring": "^1.9.0",
        "autoprefixer": "^10.6.1",
        "chalk": "^6.0.0",
        "commander": "^15.0.0",
        "cssnano": "^9.0.5",
        "esbuild": "^0.28.1",
        "fs-extra": "^11.3.6",
        "gray-matter": "^4.0.3",
        "highlightjs-line-numbers.js": "^2.9.1",
        "html-minifier-terser": "^7.2.0",
        "inquirer": "^14.2.2",
        "js-yaml": "^5.4.2",
        "jsdoc-api": "^9.3.6",
        "marked": "^18.0.14",
        "mermaid": "^12.0.0",
        "monaco-editor": "0.56.0",
        "neo-agent-skills": "^0.1.14",
        "parse5": "^8.0.1",
        "postcss": "^8.5.16",
        "sass": "^1.104.1",
        "url": "^0.11.4",
        "webpack": "^5.111.1",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.0.0",
        "webpack-hook-plugin": "^1.0.7"
    },
    "overrides": {
        "@huggingface/transformers": {
            "sharp": "^0.35.4"
        },
        "lodash-es": "^4.18.0",
        "monaco-editor": {
            "dompurify": "^3.4.13"
        }
    }
}
