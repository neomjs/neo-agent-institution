<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements of the signed release only (electron-builder.yml). V8 needs JIT in the
     app and its helpers. The Fleet child runs the app's own executable as Node and drives System Events
     and the seat apps through osascript, so those Apple Events need the automation entitlement. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
