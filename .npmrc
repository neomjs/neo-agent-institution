# Engine and Brain postinstalls materialize the same Skills projection.
foreground-scripts=true

# onnxruntime-node (through the Brain's chroma default embedder and @huggingface/transformers) downloads CUDA
# binaries in its Linux x64 install script. The Fleet runs on CPU only, and the CPU binaries ship in the npm
# package, so every install skips that download; npm hands the key to the Brain's git-clone install as well.
# Retire this key when no dependency pulls onnxruntime-node any more, or when npm's next major drops
# unknown project config: then set ONNXRUNTIME_NODE_INSTALL_CUDA=skip where installs run instead.
onnxruntime-node-install-cuda=skip
